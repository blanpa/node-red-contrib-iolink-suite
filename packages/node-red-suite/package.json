{
  "name": "node-red-contrib-iolink-suite",
  "version": "0.1.0",
  "description": "Node-RED nodes for IO-Link masters: read and write process data decoded through the device's IODD, read and write ISDU parameters by name, and decode raw IO-Link bytes from any source.",
  "license": "Apache-2.0",
  "keywords": [
    "node-red",
    "io-link",
    "iolink",
    "iodd",
    "ifm",
    "iot-core",
    "industrial",
    "automation",
    "sensor"
  ],
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "iolink-master": "nodes/iolink-master.js",
      "iolink-read": "nodes/iolink-read.js",
      "iolink-write": "nodes/iolink-write.js",
      "iolink-param": "nodes/iolink-param.js",
      "iolink-event": "nodes/iolink-event.js",
      "iolink-scan": "nodes/iolink-scan.js",
      "iodd-decode": "nodes/iodd-decode.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:docker": "docker compose -f ../../docker-compose.test.yml run --rm --build unit",
    "test:integration": "docker compose -f ../../docker-compose.test.yml run --rm --build integration",
    "test:docker:all": "docker compose -f ../../docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from integration"
  },
  "dependencies": {
    "iodd-parser": "^0.1.0"
  },
  "files": [
    "lib/",
    "nodes/",
    "README.md"
  ]
}
